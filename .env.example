# Backend Firebase Admin SDK
NODE_ENV=development
PORT=3000
FIREBASE_PROJECT_ID=olhos-do-campus-local
FIRESTORE_DATABASE_ID=(default)
FIREBASE_STORAGE_BUCKET=olhos-do-campus-local.appspot.com
ALLOWED_ADMIN_DOMAINS=ifes.edu.br
APP_CHECK_ENFORCEMENT=false
ALLOWED_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fotografias — produção exige R2; Firebase Storage permanece para Emulator e fallback temporário.
PHOTO_STORAGE_PROVIDER=firebase-storage
LEGACY_PHOTO_FALLBACK_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
RECONCILIATION_ORPHAN_SAFETY_HOURS=72
RECONCILIATION_MAX_OBJECTS=50000

# Provedor de e-mail ativo ('ews' ou 'resend')
EMAIL_PROVIDER=ews

# E-mail transacional via Exchange Web Services (EWS / IFES)
EWS_ENABLED=false
EWS_URL=https://webmail.ifes.edu.br/EWS/Exchange.asmx
EWS_DOMAIN=UPD1
EWS_USERNAME=
EWS_PASSWORD=
EWS_FROM=

# E-mail transacional via Resend (opcional / secundário)
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=

# Autenticação do Cloudflare Maintenance Worker.
MAINTENANCE_HMAC_SECRET=

# Coleta/controladoria do Artifact Registry — usada apenas pelos scripts operacionais.
ARTIFACT_REGISTRY_PROJECT_ID=
ARTIFACT_REGISTRY_LOCATION=
ARTIFACT_REGISTRY_REPOSITORY=
ARTIFACT_REGISTRY_IMAGE=

# Operações de Backup / Restore Firestore (scripts/backup/)
# FIRESTORE_PROJECT_ID=olhos-do-campus-local
# FIRESTORE_DATABASE_ID=(default)
# BACKUP_BUCKET=gs://backup-bucket-name
# TARGET_PROJECT=olhos-do-campus-staging
# TARGET_FIRESTORE_DATABASE_ID=(default)

# Emulator Suite — os três devem ser configurados conjuntamente.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Frontend Firebase Web SDK (valores públicos de configuração Firebase; não são credenciais de serviço)
VITE_FIREBASE_API_KEY=replace-with-public-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=olhos-do-campus-local.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=olhos-do-campus-local
VITE_FIREBASE_STORAGE_BUCKET=olhos-do-campus-local.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_API_BASE_URL=
VITE_USE_FIREBASE_EMULATORS=true
VITE_APP_CHECK_ENABLED=false
VITE_FIREBASE_RECAPTCHA_ENTERPRISE_SITE_KEY=
