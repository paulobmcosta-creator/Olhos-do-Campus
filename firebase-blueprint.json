{
  "version": "1.0.1",
  "project": "Olhos do Campus",
  "institution": "Instituto Federal do Espírito Santo — Campus Barra de São Francisco",
  "architecture": {
    "webClientDirectFirestoreAccess": false,
    "webClientDirectStorageAccess": false,
    "dataPath": "Cloudflare Pages → Cloud Run API → App Check → Auth → Authorization → Service → Firestore/R2/EWS/Resend"
  },
  "entities": {
    "AdminUser": {
      "collection": "adminUsers",
      "schemaVersion": 1,
      "description": "Conta administrativa do contrato da versão 0.8.0. Papéis válidos no contrato ativo: Administrador, Gestor e Atendente. Registros legados permanecem bloqueados até decisão explícita.",
      "fields": {
        "email": "string",
        "normalizedEmail": "string",
        "uid": "string?",
        "displayName": "string",
        "role": "Administrador | Gestor | Atendente",
        "teamIds": "string[]",
        "department": "string? (legado, não é mecanismo de autorização)",
        "active": "boolean",
        "legacyRole": "boolean?",
        "createdAt": "Timestamp",
        "createdBy": "string",
        "updatedAt": "Timestamp",
        "updatedBy": "string",
        "lastAuthorizedLoginAt": "Timestamp?"
      }
    },
    "Occurrence": {
      "collection": "occurrences",
      "schemaVersion": 2,
      "description": "Estado materializado atual. Mantém valores reportados imutáveis e snapshots atuais, classificação REAL/TEST, roteamento, apensamento operacional e snapshot de SLA.",
      "fields": {
        "protocol": "string",
        "trackingKeyHash": "string",
        "trackingKeySalt": "string",
        "reportedCategoryId": "string",
        "reportedCategoryNameSnapshot": "string",
        "categoryId": "string",
        "categoryNameSnapshot": "string",
        "reportedLocation": "OccurrenceLocation",
        "location": "OccurrenceLocation",
        "description": "string",
        "immediateRisk": "boolean",
        "status": "OccurrenceStatus",
        "priority": "Baixa | Normal | Alta | Urgente | Emergencial",
        "priorityRank": "number",
        "assignedTeamId": "string?",
        "assignedTeamNameSnapshot": "string?",
        "assignedToAdminUserId": "string?",
        "assignedToDisplayNameSnapshot": "string?",
        "duplicateOfOccurrenceId": "string?",
        "duplicateOfProtocol": "string?",
        "attachedToOccurrenceId": "string? (raiz do agrupamento de apensamento)",
        "attachedToProtocol": "string?",
        "attachmentRelation": "DUPLICATE | SIMILAR?",
        "attachmentReason": "string?",
        "attachedAt": "Timestamp?",
        "attachedByAdminUserId": "string?",
        "createdAt": "Timestamp",
        "updatedAt": "Timestamp",
        "closedAt": "Timestamp?",
        "resolvedAt": "Timestamp? (somente Resolvida)",
        "firstPublicResponseAt": "Timestamp?",
        "version": "number",
        "dataClassification": "REAL | TEST",
        "reopenedCount": "number",
        "reopened": "boolean (materializado para filtro)",
        "lastReopenedAt": "Timestamp?",
        "hasTeam": "boolean",
        "hasResponsible": "boolean",
        "hasPhoto": "boolean",
        "isClosed": "boolean",
        "searchTokens": "string[]",
        "sla": "OccurrenceSla"
      },
      "subcollections": {
        "events": "OccurrenceEvent (append-only)",
        "photos": "OccurrencePhoto metadata"
      }
    },
    "OccurrenceLocation": {
      "fields": {
        "campusId": "string?",
        "campusName": "string",
        "buildingId": "string?",
        "buildingName": "string",
        "floorId": "string?",
        "floor": "string",
        "roomId": "string?",
        "room": "string",
        "complement": "string?",
        "isOther": "boolean?",
        "otherDescription": "string?"
      }
    },
    "OccurrenceSla": {
      "schemaVersion": 1,
      "fields": {
        "policyVersion": "string",
        "firstResponseTargetBusinessMinutes": "number",
        "firstResponseDueAt": "Timestamp",
        "firstResponseAt": "Timestamp?",
        "firstResponseOutcome": "ON_TIME | BREACHED?",
        "resolutionBaseBusinessMinutes": "number",
        "priorityMultiplier": "number",
        "resolutionTargetBusinessMinutes": "number",
        "resolutionDueAt": "Timestamp",
        "resolutionNearDueAt": "Timestamp",
        "resolutionPaused": "boolean",
        "resolutionPauseStartedAt": "Timestamp?",
        "accumulatedPausedBusinessMinutes": "number",
        "completedAt": "Timestamp?",
        "resolutionOutcome": "ON_TIME | BREACHED?",
        "calendarSnapshotId": "string",
        "calendarSnapshot": "{ calendar, exceptions } (snapshot histórico)",
        "legacyAssessment": "CALCULATED | ESTIMATED | UNAVAILABLE?"
      },
      "description": "Snapshot persistente da política aplicada. O tempo efetivo decorrido é calculado no servidor/DTO a partir do snapshot e dos períodos de pausa."
    },
    "OccurrenceEvent": {
      "path": "occurrences/{occurrenceId}/events/{eventId}",
      "appendOnly": true,
      "fields": {
        "visibility": "PUBLIC | INTERNAL",
        "audience": "ADMIN_ONLY | ADMINS_AND_MANAGERS | RESPONSIBLE_TEAM?",
        "audienceTeamIdSnapshot": "string? (snapshot da equipe quando audiência RESPONSIBLE_TEAM)",
        "reason": "string?",
        "createdAt": "Timestamp",
        "actorAdminUserId": "string?",
        "actorDisplayNameSnapshot": "string?",
        "actorRoleSnapshot": "string?",
        "eventType": "OccurrenceEventType"
      }
    },
    "Category": {
      "collection": "categories",
      "schemaVersion": 2,
      "fields": {
        "id": "stable document id",
        "name": "string",
        "description": "string?",
        "active": "boolean",
        "sortOrder": "number",
        "resolutionBaseBusinessHours": "number",
        "version": "number",
        "updatedAt": "Timestamp",
        "updatedBy": "string"
      },
      "physicalDeleteWhenReferenced": false
    },
    "LocationHierarchy": {
      "collection": "locations",
      "description": "Um campus ativo nesta versão; áreas/blocos e ambientes com identificadores estáveis. Não há pavimentos institucionais inventados.",
      "fields": {
        "campusId": "ifes-bsf",
        "campusName": "IFES — Campus Barra de São Francisco",
        "buildings": "Bloco 01 | Bloco 02 | Bloco 03 | Externo",
        "rooms": "60 ambientes iniciais",
        "active": "boolean",
        "sortOrder": "number",
        "version": "number"
      },
      "physicalDeleteWhenReferenced": false,
      "schemaVersion": 2
    },
    "OperationalTeam": {
      "collection": "operationalTeams",
      "schemaVersion": 1,
      "fields": {
        "name": "string",
        "description": "string?",
        "active": "boolean",
        "sortOrder": "number",
        "memberAdminUserIds": "string[]",
        "createdAt": "Timestamp",
        "createdBy": "string",
        "updatedAt": "Timestamp",
        "updatedBy": "string"
      },
      "physicalDeleteWhenReferenced": false
    },
    "SlaConfiguration": {
      "path": "systemSettings/sla",
      "schemaVersion": 1,
      "fields": {
        "policyVersion": "string",
        "firstResponseBusinessHours": "Record<priority, number>",
        "priorityMultipliers": "Record<priority, number>",
        "nearDueThresholdPercent": "number",
        "version": "number",
        "updatedAt": "Timestamp",
        "updatedBy": "string"
      }
    },
    "ServiceCalendar": {
      "path": "serviceCalendars/default",
      "schemaVersion": 1,
      "fields": {
        "timezone": "America/Sao_Paulo",
        "weekly": "segunda-sexta 09:00-19:00; sábado/domingo fechados por default",
        "version": "number",
        "updatedAt": "Timestamp",
        "updatedBy": "string"
      }
    },
    "ServiceCalendarException": {
      "collection": "serviceCalendarExceptions",
      "schemaVersion": 1,
      "fields": {
        "date": "YYYY-MM-DD",
        "type": "FERIADO | RECESSO | SUSPENSAO | HORARIO_ESPECIAL",
        "label": "string",
        "closed": "boolean",
        "start": "HH:mm?",
        "end": "HH:mm?",
        "createdAt": "Timestamp",
        "createdBy": "string",
        "updatedAt": "Timestamp",
        "updatedBy": "string"
      }
    },
    "AuditLog": {
      "collection": "auditLogs",
      "appendOnly": true,
      "fields": {
        "eventType": "AuditEventType",
        "actorUid": "string?",
        "actorEmail": "string?",
        "actorRole": "Administrador | Gestor?",
        "targetType": "string",
        "targetId": "string?",
        "timestamp": "Timestamp",
        "summary": "string",
        "requestCorrelationId": "string?",
        "metadata": "record de metadados operacionais não sensíveis?"
      }
    },
    "ProtocolCounter": {
      "path": "protocolCounters/{year}",
      "fields": {
        "lastSequence": "number",
        "updatedAt": "Timestamp"
      }
    },
    "SystemConfig": {
      "path": "/systemSettings/operational",
      "fields": {
        "notificationEmails": "string[]",
        "emailNotificationsEnabled": "boolean"
      }
    },
    "NotificationOutbox": {
      "collection": "notificationOutbox",
      "description": "Intenção lógica de notificação por destinatário. Mantém estado agregado, lease e cache da tentativa corrente; retries externos individuais ficam na subcoleção attempts.",
      "fields": {
        "status": "NotificationStatus",
        "recipientHash": "sha256",
        "idempotencyKey": "string (cache da chave da tentativa corrente; legado compatível)",
        "idempotencySafeUntil": "Timestamp?",
        "providerAcceptedAt": "Timestamp?",
        "lastProviderEventAt": "Timestamp?",
        "lastProviderEventType": "string?",
        "lastFailureCategory": "string?",
        "leaseUntil": "Timestamp?",
        "attemptCount": "number (cache agregado de DeliveryAttempts independentes; retry técnico da mesma tentativa não incrementa)",
        "currentAttemptId": "sha256?",
        "providerMessageId": "string? (cache do último providerMessageId; legado 0.7.2 compatível)",
        "retryMode": "SAME_ATTEMPT | NEW_ATTEMPT? (orienta o próximo claim)",
        "retrySafety": "IDEMPOTENCY_WINDOW | PROVIDER_REJECTED?"
      },
      "schemaVersion": 2
    },
    "InfrastructureUsageSnapshot": {
      "collection": "infrastructureUsageSnapshots",
      "description": "Métricas técnicas agregadas sem conteúdo pessoal ou de ocorrência."
    },
    "NotificationWebhookEvent": {
      "collection": "notificationWebhookEvents",
      "description": "Metadados mínimos de webhooks Resend para deduplicação, correlação attempt-aware e reconciliação server-only; nenhum payload bruto é persistido.",
      "fields": {
        "eventType": "string",
        "providerMessageId": "string",
        "notificationId": "sha256?",
        "occurredAt": "Timestamp",
        "status": "UNMATCHED_PENDING | PROCESSED | UNMATCHED_EXPIRED | INCONSISTENT",
        "firstSeenAt": "Timestamp",
        "lastAttemptAt": "Timestamp",
        "attemptCount": "number",
        "nextAttemptAt": "Timestamp?",
        "processedAt": "Timestamp?",
        "targetNotificationId": "sha256?",
        "lastErrorCode": "string?",
        "retentionUntil": "Timestamp",
        "attemptId": "sha256?",
        "targetAttemptId": "sha256?"
      }
    },
    "NotificationDeliveryAttempt": {
      "path": "/notificationOutbox/{notificationId}/attempts/{attemptId}",
      "schemaVersion": 1,
      "description": "Tentativa externa individual de entrega Resend. Retry técnico reutiliza o mesmo attemptId e a mesma idempotency key; nova tentativa externa cria outro documento somente após decisão segura.",
      "fields": {
        "notificationId": "sha256",
        "attemptNumber": "number",
        "status": "PROCESSING | RETRY_PENDING | ACCEPTED | UNCERTAIN | DELIVERED | BOUNCED | COMPLAINED | FAILED | SUPPRESSED",
        "idempotencyKey": "string",
        "providerAcceptedAt": "Timestamp?",
        "providerMessageId": "string?",
        "createdAt": "Timestamp",
        "startedAt": "Timestamp",
        "updatedAt": "Timestamp",
        "completedAt": "Timestamp?",
        "failureCategory": "string?",
        "lastErrorCode": "string?",
        "lastErrorSummary": "string?",
        "lastProviderEventAt": "Timestamp?",
        "lastProviderEventType": "string?",
        "technicalRetryCount": "number (repetições técnicas da mesma DeliveryAttempt; não é consumo nem attemptNumber)",
        "retryMode": "SAME_ATTEMPT?",
        "retrySafety": "IDEMPOTENCY_WINDOW | PROVIDER_REJECTED?",
        "nextAttemptAt": "Timestamp?"
      }
    }
  },
  "security": {
    "firestoreClientRules": "deny-all",
    "storageClientRules": "deny-all",
    "publicTracking": "protocolo + chave fora da URL",
    "publicRegistration": "Firebase Authentication anônima",
    "administrativeAuthentication": "Google Sign-In + allowlist adminUsers",
    "appCheck": true,
    "photoProcessing": "server-only, EXIF removido",
    "photoStorage": "Cloudflare R2 privado em produção; Firebase Storage somente emulador/migração legada",
    "notificationDelivery": "EWS institucional (IFES) / Resend server-only com outbox transacional, binding determinístico por provedor, retry técnico idempotente por DeliveryAttempt e ausência de fallback silencioso",
    "maintenanceAuthentication": "HMAC SHA-256 sobre método, path e timestamp",
    "optimisticLocking": "expectedVersion + HTTP 409"
  }
}
