{
  "name": "olhos-do-campus-bsf",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema do IFES — Campus Barra de São Francisco para registro e acompanhamento de problemas relacionados à infraestrutura física.",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:fullstack": "tsx watch server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server/index.js",
    "build:pages": "npm run build:client",
    "build:cloud-run": "npm run build:server && node scripts/prepareProductionPackage.mjs",
    "gcp-build": "npm run build:client",
    "start": "node aistudio-publish.mjs",
    "start:api": "node dist/server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --exclude tests/firebaseRules.test.ts --exclude tests/firebaseIntegration.test.ts --exclude tests/storageIntegration.test.ts",
    "test:watch": "vitest --exclude tests/firebaseRules.test.ts --exclude tests/firebaseIntegration.test.ts --exclude tests/storageIntegration.test.ts",
    "test:rules": "firebase emulators:exec --project olhos-do-campus-local --only firestore,storage \"vitest run tests/firebaseRules.test.ts\"",
    "test:firebase": "firebase emulators:exec --project olhos-do-campus-local --only auth,firestore,storage \"vitest run tests/firebaseIntegration.test.ts\"",
    "emulators": "firebase emulators:start --project olhos-do-campus-local --only auth,firestore,storage",
    "emulators:export": "firebase emulators:export .firebase-export --force",
    "firebase:bootstrap-admin": "tsx scripts/bootstrapAdmin.ts",
    "firebase:seed-reference-data": "tsx scripts/seedReferenceData.ts",
    "firebase:seed-demo-data": "tsx scripts/seedDemoData.ts",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build",
    "clean": "rimraf dist coverage .vitest .firebase-export",
    "storage:cleanup": "tsx scripts/storageCleanup.ts",
    "storage:migrate:r2": "tsx scripts/migrateStorageToR2.ts",
    "storage:reconcile": "tsx scripts/reconcilePhotoStorage.ts",
    "infra:artifact-cleanup:dry-run": "tsx scripts/artifactRegistryCleanup.ts --dry-run",
    "infra:artifact-cleanup:apply": "tsx scripts/artifactRegistryCleanup.ts --apply",
    "infra:artifact-snapshot": "tsx scripts/artifactRegistrySnapshot.ts",
    "worker:typecheck": "npm --prefix infra/cloudflare/maintenance-worker run typecheck",
    "worker:test": "vitest run tests/maintenanceWorker070.test.ts",
    "test:ews": "vitest run tests/ewsIntegration.optIn.test.ts",
    "test:r2": "vitest run tests/r2Integration.optIn.test.ts",
    "test:resend": "vitest run tests/resendIntegration.optIn.test.ts",
    "test:storage": "firebase emulators:exec --project olhos-do-campus-local --only firestore,storage \"vitest run tests/storageIntegration.test.ts\"",
    "firebase:migrate-0.6": "tsx scripts/migrate060.ts",
    "firebase:seed-campus-spaces": "tsx scripts/seedCampusSpaces.ts",
    "prepare:production-package": "node scripts/prepareProductionPackage.mjs",
    "check:scale": "node scripts/checkScaleConfig.mjs",
    "verify:release": "node scripts/verifyRelease.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1112.0",
    "@fastify/busboy": "3.2.0",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "firebase": "12.17.1",
    "firebase-admin": "14.2.0",
    "lucide-react": "0.546.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "resend": "6.20.0",
    "sharp": "0.35.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@adobe/css-tools": "^4.5.0",
    "@cloudflare/workers-types": "5.20260818.1",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "5.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/express": "4.17.25",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "css.escape": "^1.5.1",
    "esbuild": "0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.22",
    "firebase-tools": "15.25.1",
    "globals": "^16.4.0",
    "jsdom": "^30.0.1",
    "redent": "^4.0.0",
    "rimraf": "6.0.1",
    "tailwindcss": "4.3.3",
    "tough-cookie": "^6.0.2",
    "tsx": "4.23.7",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.44.1",
    "vite": "6.4.3",
    "vitest": "^4.1.10",
    "wrangler": "4.124.0"
  },
  "overrides": {
    "@opentelemetry/core": "2.8.0",
    "gaxios": {
      "uuid": "11.1.1"
    },
    "teeny-request": {
      "uuid": "11.1.1"
    },
    "qs": "6.16.0"
  }
}
